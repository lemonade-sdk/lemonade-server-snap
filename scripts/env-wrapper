#!/bin/bash
# Exports optional LEMONADE_API_KEY / LEMONADE_ADMIN_API_KEY from snap config
# (set via `snap set lemonade-server lemonade-api-key=...`) before handing
# off to the rest of the command chain.
set -e

api_key="$(snapctl get lemonade-api-key)"
admin_api_key="$(snapctl get lemonade-admin-api-key)"

[ -n "$api_key" ] && export LEMONADE_API_KEY="$api_key"
[ -n "$admin_api_key" ] && export LEMONADE_ADMIN_API_KEY="$admin_api_key"

exec "$@"
